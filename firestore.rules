rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteConfig/toyMap {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /siteConfig/siteInfo {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
